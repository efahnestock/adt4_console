#compdef bag-drive
# zsh completion for bag-drive. Installed to
# /usr/local/share/zsh/site-functions/_bag-drive by install.sh.
# Drive names come from "bag-drive status --json", which needs no sudo.

_bag_drive_names() {
    local -a names
    names=(${(f)"$(bag-drive status --json 2>/dev/null | python3 -c '
import json, sys
for d in json.load(sys.stdin).get("drives", []):
    print(d["name"])' 2>/dev/null)"})
    names=(${names:|words})  # drop drives already on the line
    _describe -t drives 'bag drive' names
}

_bag-drive() {
    local curcontext="$curcontext" state line
    _arguments -C \
        '(- *)'{-h,--help}'[show help]' \
        '1:command:((status\:"list bag drives" eject\:"sync, unmount and power down drives" unmount\:"same as eject"))' \
        '*::arg:->args'
    case $state in
        args)
            case $line[1] in
                status) _arguments '--json[machine-readable output]' ;;
                eject|unmount|umount)
                    _arguments '(*)--all[every bag drive]' '*:drive:_bag_drive_names' ;;
            esac ;;
    esac
}

_bag-drive "$@"
